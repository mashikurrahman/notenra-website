# ---------------------------------------------------------------------------
# Lead delivery (contact form + every "Book Demo" button)
#
# Copy this file to .env.local and fill in the values. .env.local is gitignored.
# In production, set the same three variables in your host's dashboard
# (Vercel: Project → Settings → Environment Variables).
#
# Without RESEND_API_KEY the form returns a clear "temporarily unavailable"
# error and logs the submission server-side, rather than showing a visitor a
# fake success screen.
# ---------------------------------------------------------------------------

# From https://resend.com/api-keys — "Sending access" is the only scope needed.
RESEND_API_KEY=

# Must be on a domain verified in Resend (Domains → Add Domain, then add the
# DNS records it gives you). An unverified sender is rejected outright.
LEAD_FROM_EMAIL=leads@notenra.com

# Where lead notifications land. Any address, no verification needed.
LEAD_TO_EMAIL=hello@notenra.com
